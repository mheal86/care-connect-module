  "components": {
    "schemas": {
      "CareCatalogPayload": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 2,
            "title": "Name"
          },
          "facility_type": {
            "type": "string",
            "enum": [
              "nursing_home",
              "day_care",
              "rehab",
              "home_care"
            ],
            "title": "Facility Type"
          },
          "region": {
            "type": "string",
            "enum": [
              "hcm",
              "hanoi",
              "danang"
            ],
            "title": "Region"
          },
          "address": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 5,
            "title": "Address"
          },
          "description": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 5,
            "title": "Description"
          },
          "phone": {
            "type": "string",
            "maxLength": 64,
            "title": "Phone",
            "default": ""
          },
          "published": {
            "type": "boolean",
            "title": "Published"
          },
          "amenities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Amenities"
          },
          "services": {
            "items": {
              "$ref": "#/components/schemas/CareCatalogServicePayload"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Services"
          }
        },
        "type": "object",
        "required": [
          "name",
          "facility_type",
          "region",
          "address",
          "description",
          "published",
          "services"
        ],
        "title": "CareCatalogPayload",
        "description": "Validated catalogue input; verification flags are never supplied by clients."
      },
      "CareCatalogServicePayload": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "category": {
            "type": "string",
            "enum": [
              "stay",
              "day",
              "rehab",
              "medical"
            ],
            "title": "Category"
          },
          "price": {
            "type": "integer",
            "maximum": 2000000000.0,
            "minimum": 0.0,
            "title": "Price"
          },
          "price_unit": {
            "type": "string",
            "enum": [
              "month",
              "day",
              "session"
            ],
            "title": "Price Unit"
          },
          "ui_id": {
            "type": "string",
            "enum": [
